# Copy to .env and fill in. Everything here is optional at Milestone 1 —
# the graph runs end to end with stub search nodes and no keys at all.

ENVIRONMENT=local
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["http://localhost:3000"]

# LLM (Milestone 2 onwards)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Travel APIs (Milestones 2-4) — one provider each, no booking
FLIGHT_API_KEY=
HOTEL_API_KEY=
PLACES_API_KEY=
MAPS_API_KEY=

# Langfuse (Milestone 6)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
