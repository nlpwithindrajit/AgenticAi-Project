# Copy to .env and fill in. Everything here is optional at Milestone 1 —
# the graph runs end to end with stub search nodes and no keys at all.

ENVIRONMENT=local
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["http://localhost:3000"]

# LLM — optional. Without it the Flight agent uses a deterministic search plan.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium

# SerpAPI Google Flights (flights) — https://serpapi.com/manage-api-key
# The default flight provider: live Google Flights fares, no OAuth dance.
# Without it the Flight agent falls back to clearly-labelled STUB inventory.
SERPAPI_API_KEY=

# Which provider answers flight searches: auto | serpapi | amadeus.
# `auto` prefers SerpAPI when its key is set. An explicit choice is never
# silently swapped for the other — it falls back to stubs instead.
FLIGHT_PROVIDER=auto

# Round trips cost TWO SerpAPI searches: one for outbound itineraries, then one
# per candidate to price its return leg. This caps the second kind, and is also
# how many recommendations come back. 3 => 4 searches per trip plan.
# 0 skips them: 1 search, correct round-trip price, outbound leg only.
SERPAPI_RETURN_LOOKUPS=3

# Amadeus Self-Service — https://developers.amadeus.com
# Still the provider for hotels, activities and points of interest. Also
# selectable for flights via FLIGHT_PROVIDER=amadeus, though its free test tier
# has limited inventory and prices that are not live. Switch AMADEUS_BASE_URL
# for production keys.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Travel APIs (Milestones 3-4) — one provider each, no booking
HOTEL_API_KEY=
PLACES_API_KEY=
MAPS_API_KEY=

# Langfuse (Milestone 6) — optional. Without keys, tracing is a no-op.
# With them, every request is one trace: a span per agent, per Amadeus
# call and per LLM call, plus review/budget scores.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL is accepted as an alias — use your region's URL,
# e.g. https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
# An unreachable Langfuse costs at most this per request, never an error.
LANGFUSE_TIMEOUT_SECONDS=3
