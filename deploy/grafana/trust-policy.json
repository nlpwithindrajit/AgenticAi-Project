{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GrafanaCloudAssumeRole",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::__GRAFANA_ACCOUNT_ID__:root"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "__EXTERNAL_ID__"
        }
      }
    }
  ]
}
