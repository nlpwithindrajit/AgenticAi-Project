{
  "family": "travel-planner-ui",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::__ACCOUNT__:role/travelPlannerEcsExecutionRole",
  "containerDefinitions": [
    {
      "name": "ui",
      "image": "__IMAGE__",
      "essential": true,
      "portMappings": [{ "containerPort": 3000, "protocol": "tcp" }],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "3000" },
        { "name": "HOSTNAME", "value": "0.0.0.0" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/travel-planner-ui",
          "awslogs-region": "__REGION__",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
